@page "/clubs/{ClubId:guid}/schedule"
@attribute [Authorize]
@inject IAuthService AuthService
@inject IClubService ClubService
@inject ICourtService CourtService
@inject IMembershipService MembershipService
@inject IReservationService ReservationService
@inject IBookingRuleService BookingRuleService
@inject NavigationManager Navigation

<PageTitle>Raspored terena</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Učitavanje...</span>
        </div>
    </div>
}
else if (!_hasAccess)
{
    <div class="alert alert-warning">Raspored terena dostupan je samo odobrenim članovima kluba.</div>
}
else
{
    <!-- Date navigation header -->
    <div class="d-flex flex-column align-items-center mb-3">
        <h1 class="fs-5 fw-bold text-uppercase mb-2 letter-spacing-1">
            @FormatDate(_selectedDate)
        </h1>
        <div class="btn-group" role="group" aria-label="Navigacija datuma">
            <button class="btn btn-outline-secondary" @onclick="GoToPreviousDay">Prije</button>
            <button class="btn btn-outline-secondary" @onclick="GoToToday">Danas</button>
            <button class="btn btn-outline-secondary" @onclick="GoToNextDay">Poslije</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success">@_successMessage</div>
    }

    @if (_courts.Count == 0)
    {
        <p>Klub još nema evidentiranih terena.</p>
    }
    else if (_isLoadingReservations)
    {
        <div class="d-flex justify-content-center py-4">
            <div class="spinner-border spinner-border-sm text-success" role="status">
                <span class="visually-hidden">Učitavanje rasporeda...</span>
            </div>
        </div>
    }
    else
    {
        <CourtTimelineGrid Courts="_courts"
                           Reservations="_reservations"
                           Date="_selectedDate"
                           CurrentUserId="_currentUserId"
                           MinBookingHours="@(_bookingRules?.MinHoursPerBooking ?? 0.5m)"
                           OnSlotClicked="HandleSlotClicked" />
    }

    <div class="mt-3">
        <a href="@($"/clubs/{ClubId}")" class="btn btn-outline-secondary">Natrag na klub</a>
    </div>
}

<!-- Booking modal (pure Blazor, no Bootstrap JS required) -->
@if (_showModal && _pendingSlot is not null)
{
    <div class="schedule-modal-overlay" @onclick="CloseModal">
        <div class="schedule-modal" @onclick:stopPropagation="true">
            <h5 class="mb-3">Nova rezervacija</h5>

            <dl class="row mb-3">
                <dt class="col-5">Teren</dt>
                <dd class="col-7">@_pendingSlot.CourtName</dd>
                <dt class="col-5">Datum</dt>
                <dd class="col-7">@_selectedDate.ToString("dd.MM.yyyy.")</dd>
                <dt class="col-5">Početak</dt>
                <dd class="col-7">@_pendingSlot.Start.ToString("HH:mm")</dd>
                <dt class="col-5">Kraj</dt>
                <dd class="col-7">@GetSelectedEndLocal(_pendingSlot).ToString("HH:mm")</dd>
            </dl>

            @if (_bookingRules is not null)
            {
                <p class="text-muted small mb-3">
                    Min. @_bookingRules.MinHoursPerBooking h po rezervaciji,
                    Maks. @_bookingRules.MaxHoursPerBooking h po rezervaciji,
                    maks. @_bookingRules.MaxAdvanceDays dana unaprijed.
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(_modalError))
            {
                <div class="alert alert-danger py-2">@_modalError</div>
            }

            <div class="mb-3">
                <label class="form-label" for="booking-duration">Trajanje</label>
                <select id="booking-duration" class="form-select" @bind="_selectedDurationHours">
                    @foreach (var option in _durationOptions)
                    {
                        <option value="@option">@FormatDuration(option)</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-outline-secondary" @onclick="CloseModal" disabled="@_isCreating">Odustani</button>
                <button class="btn btn-primary" @onclick="ConfirmBookingAsync" disabled="@_isCreating">
                    @if (_isCreating)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Potvrdi rezervaciju
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid ClubId { get; set; }

    private readonly List<TennisHub.Core.Models.Court> _courts = [];
    private readonly List<TennisHub.Core.Models.Reservation> _reservations = [];
    private TennisHub.Core.Models.ClubBookingRule? _bookingRules;
    private bool _isLoading = true;
    private bool _isLoadingReservations;
    private bool _hasAccess;
    private Guid _currentUserId;
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _errorMessage;
    private string? _successMessage;

    // Modal state
    private bool _showModal;
    private bool _isCreating;
    private string? _modalError;
    private CourtTimelineGrid.SlotClickedArgs? _pendingSlot;
    private decimal _selectedDurationHours;
    private readonly List<decimal> _durationOptions = [];

    // ── Croatian day / month names for header ─────────────────────────────────

    private static readonly string[] DayNames =
        ["Nedjelja", "Ponedjeljak", "Utorak", "Srijeda", "Četvrtak", "Petak", "Subota"];

    private static readonly string[] MonthNames =
        ["siječnja", "veljače", "ožujka", "travnja", "svibnja", "lipnja",
         "srpnja", "kolovoza", "rujna", "listopada", "studenoga", "prosinca"];

    private static readonly TimeOnly ScheduleEndTime = new(22, 0);

    private static string FormatDate(DateOnly date)
    {
        var dt = date.ToDateTime(TimeOnly.MinValue);
        return $"{DayNames[(int)dt.DayOfWeek].ToUpperInvariant()}, {dt.Day}. {MonthNames[dt.Month - 1].ToUpperInvariant()} {dt.Year}.";
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;
        _hasAccess = false;
        _courts.Clear();

        await AuthService.InitializeAsync();
        var user = AuthService.CurrentUser;
        if (user is null || !Guid.TryParse(user.Id, out var userId))
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        _currentUserId = userId;

        var membership = await MembershipService.GetMembershipAsync(ClubId, userId);
        _hasAccess = membership?.Status == TennisHub.Core.Enums.MembershipStatus.Approved;

        if (_hasAccess)
        {
            try
            {
                _courts.AddRange(await CourtService.GetCourtsAsync(ClubId));
                _bookingRules = await BookingRuleService.GetRulesAsync(ClubId);
                await LoadReservationsAsync(_selectedDate);
            }
            catch (Exception ex)
            {
                _errorMessage = $"Neuspješno učitavanje podataka: {ex.Message}";
            }
        }

        _isLoading = false;
    }

    private async Task LoadReservationsAsync(DateOnly date)
    {
        _isLoadingReservations = true;
        _reservations.Clear();

        try
        {
            _reservations.AddRange(await ReservationService.GetReservationsForClubAsync(ClubId, date));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Neuspješno učitavanje rezervacija: {ex.Message}";
        }
        finally
        {
            _isLoadingReservations = false;
        }
    }

    // ── Date navigation ───────────────────────────────────────────────────────

    private Task GoToPreviousDay() => ChangeDateAsync(_selectedDate.AddDays(-1));
    private Task GoToToday() => ChangeDateAsync(DateOnly.FromDateTime(DateTime.Today));
    private Task GoToNextDay() => ChangeDateAsync(_selectedDate.AddDays(1));

    private async Task ChangeDateAsync(DateOnly date)
    {
        _selectedDate = date;
        _errorMessage = null;
        _successMessage = null;
        await LoadReservationsAsync(_selectedDate);
    }

    // ── Modal helpers ─────────────────────────────────────────────────────────

    private void HandleSlotClicked(CourtTimelineGrid.SlotClickedArgs args)
    {
        _pendingSlot = args;
        _durationOptions.Clear();

        var minHours = _bookingRules?.MinHoursPerBooking ?? 0.5m;
        var maxHours = _bookingRules?.MaxHoursPerBooking ?? 24m;
        if (maxHours < minHours)
        {
            _modalError = "Pravila rezervacije nisu ispravno postavljena (min > max).";
            _showModal = true;
            return;
        }

        var maxByRule = Math.Floor(maxHours * 2) / 2m;
        var minByRule = Math.Ceiling(minHours * 2) / 2m;
        var maxByAvailability = GetMaxAvailableHours(args.CourtId, args.Start);
        var effectiveMax = Math.Min(maxByRule, maxByAvailability);

        for (var duration = minByRule; duration <= effectiveMax; duration += 0.5m)
        {
            _durationOptions.Add(duration);
        }

        if (_durationOptions.Count == 0)
        {
            _modalError = "Za odabrani termin nema slobodnog trajanja koje zadovoljava pravila kluba.";
            _showModal = true;
            return;
        }

        _selectedDurationHours = _durationOptions[0];
        _modalError = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _pendingSlot = null;
        _modalError = null;
        _durationOptions.Clear();
    }

    private async Task ConfirmBookingAsync()
    {
        if (_pendingSlot is null) return;

        _isCreating = true;
        _modalError = null;

        try
        {
            var startUtc = _pendingSlot.Start.ToUniversalTime();
            if (!_durationOptions.Contains(_selectedDurationHours))
            {
                _modalError = "Odabrano trajanje nije dostupno za ovaj termin.";
                return;
            }

            var endUtc = GetSelectedEndLocal(_pendingSlot).ToUniversalTime();

            // Determine club_id via the court
            var court = _courts.FirstOrDefault(c => c.Id == _pendingSlot.CourtId);
            if (court is null)
            {
                _modalError = "Teren nije pronađen.";
                return;
            }

            var result = await ReservationService.CreateReservationAsync(
                _pendingSlot.CourtId, ClubId, _currentUserId, startUtc, endUtc);

            if (result is null)
            {
                _modalError = "Kreiranje rezervacije nije uspjelo.";
                return;
            }

            _successMessage = $"Rezervacija za {_pendingSlot.CourtName} ({_pendingSlot.Start:HH:mm} - {GetSelectedEndLocal(_pendingSlot):HH:mm}) je uspješno kreirana.";
            CloseModal();
            await LoadReservationsAsync(_selectedDate);
        }
        catch (Exception ex)
        {
            _modalError = $"Kreiranje rezervacije nije uspjelo: {ex.Message}";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private DateTime GetSelectedEndLocal(CourtTimelineGrid.SlotClickedArgs slot)
        => slot.Start.AddMinutes((double)_selectedDurationHours * 60);

    private decimal GetMaxAvailableHours(Guid courtId, DateTime slotStartLocal)
    {
        var scheduleEndLocal = _selectedDate.ToDateTime(ScheduleEndTime, DateTimeKind.Local);
        var nextReservationStart = _reservations
            .Where(x => x.CourtId == courtId)
            .Select(x => x.StartTime.ToLocalTime())
            .Where(x => x > slotStartLocal)
            .DefaultIfEmpty(scheduleEndLocal)
            .Min();

        var maxMinutes = Math.Max(0, (nextReservationStart - slotStartLocal).TotalMinutes);
        return Math.Floor((decimal)(maxMinutes / 30)) / 2m;
    }

    private static string FormatDuration(decimal hours)
        => $"{hours:0.##} h";
}
