@page "/register"
@inject IAuthService AuthService
@inject SupabaseAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Registracija</PageTitle>

<h1>Registracija</h1>

<EditForm Model="_model" OnValidSubmit="RegisterAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="fullName">Ime i prezime</label>
        <InputText id="fullName" class="form-control" @bind-Value="_model.FullName" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="_model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Lozinka</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    <button class="btn btn-primary" type="submit" disabled="@_isLoading">Registriraj se</button>
</EditForm>

<p class="mt-3">Već imate račun? <a href="/login">Prijavite se</a>.</p>

@code {
    private readonly RegisterModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.CurrentUser is not null)
        {
            Navigation.NavigateTo("/clubs", true);
        }
    }

    private async Task RegisterAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await AuthService.SignUpAsync(_model.Email, _model.Password, _model.FullName);

        if (result.Success)
        {
            AuthStateProvider.NotifyAuthenticationStateChangedAsync();
            Navigation.NavigateTo("/clubs", true);
        }
        else
        {
            _errorMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
                ? "Registracija nije uspjela."
                : result.ErrorMessage;
        }

        _isLoading = false;
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Ime i prezime je obavezno.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email je obavezan.")]
        [EmailAddress(ErrorMessage = "Unesite ispravnu email adresu.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Lozinka je obavezna.")]
        [MinLength(6, ErrorMessage = "Lozinka mora imati najmanje 6 znakova.")]
        public string Password { get; set; } = string.Empty;
    }
}
